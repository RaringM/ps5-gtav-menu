/* feature_descriptions.def -- single source of truth for menu row -> footer help text.
 *
 * This is an "X-macro" table (see feature_actions.def for the pattern): a plain list of
 * data, included with the row macro defined differently each time. item_description() in
 * native_bridge.cpp builds its action -> footer-help lookup from THIS list, so adding a
 * feature's footer help is a one-line edit here instead of another hand-maintained switch
 * case that can silently fall through to a blank footer.
 *
 *   GTAV_ACTION_DESC(ENUM_SUFFIX, "help")  one action id -> one footer help string
 *
 * The name maps to GTAV_NATIVE_SHELL_ACTION_<ENUM_SUFFIX> in include/gtavmenu/native_bridge.h.
 * Only actions that need a non-empty footer string are listed; any leaf menu row missing
 * here renders a blank footer and is caught by tests/test_item_description_coverage.py.
 * Rows handled BEFORE the switch -- unavailable rows (their unavailable_reason) and
 * SHELL_ROW_SUBMENU ("Open this submenu") -- are intentionally not listed here.
 *
 * Unlike feature_actions.def, the per-slot mod pickers (MOD_SPOILER..MOD_HORN) are listed
 * as ordinary rows: each has its own distinct help string, so there is no positional-array
 * trick -- they are plain switch cases like every other action.
 */

#ifndef GTAV_ACTION_DESC
#define GTAV_ACTION_DESC(suffix, desc)
#endif

