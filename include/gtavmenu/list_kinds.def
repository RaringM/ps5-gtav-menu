GTAV_LIST_KIND(CYCLE_NAV_DELAY, SETTING)
GTAV_LIST_KIND(CYCLE_NAV_SPEED, SETTING)
GTAV_LIST_KIND(CYCLE_WORKER_HZ, SETTING)
GTAV_LIST_KIND(CYCLE_TOAST_TIME, SETTING_TOAST)

/* Custom Packs: "Uninstall < id >" picks an installed pack; Cross uninstalls it behind the
   two-press confirm (menu.c action_needs_confirm). */
GTAV_LIST_KIND(UNINSTALL_PACK, CHOICE)
