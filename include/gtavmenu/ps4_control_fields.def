/* PS4 worker control block, ABI v2: the single source for the C struct (ps4_slice.h) and the host
 * decoder (the development tree's Python decoder parses this file). 512 bytes, natural alignment,
 * no implicit padding: keep every field aligned to its size.
 *
 * Ownership: the host writes only the fields marked HOST; every other field belongs to the worker
 * (the hooked game thread, or _main at load). Host commands use the shared command mailbox
 * (gtav_menu_command_mailbox), not this block.
 *
 * GTAV_PS4_FIELD(c_type, name, struct_format, owner)
 * GTAV_PS4_ARRAY(c_type, name, count, struct_format, owner) */

GTAV_PS4_FIELD(uint64_t, magic, Q, WORKER)
GTAV_PS4_FIELD(uint32_t, abi_version, I, WORKER)
GTAV_PS4_FIELD(uint32_t, struct_size, I, WORKER)
GTAV_PS4_FIELD(uint32_t, state, I, HOST)
GTAV_PS4_FIELD(uint32_t, host_flags, I, HOST)
GTAV_PS4_FIELD(uint32_t, worker_flags, I, WORKER)
GTAV_PS4_FIELD(uint32_t, pid, I, HOST)
GTAV_PS4_FIELD(uint32_t, session_nonce, I, HOST)
GTAV_PS4_FIELD(uint32_t, last_error, I, WORKER)
GTAV_PS4_FIELD(uint32_t, loader_entry_seen, I, WORKER)
GTAV_PS4_FIELD(uint32_t, native_ready, I, WORKER)
GTAV_PS4_FIELD(uint64_t, gateway_address, Q, HOST)
GTAV_PS4_FIELD(uint64_t, thunk_address, Q, HOST)
GTAV_PS4_FIELD(uint64_t, hook_calls, Q, WORKER)
GTAV_PS4_FIELD(uint64_t, game_frames, Q, WORKER)
GTAV_PS4_FIELD(uint32_t, inflight, I, WORKER)
GTAV_PS4_FIELD(uint32_t, quiesced, I, WORKER)
GTAV_PS4_FIELD(uint32_t, last_frame_count, I, WORKER)
GTAV_PS4_FIELD(uint32_t, captured_ped, I, WORKER)
GTAV_PS4_FIELD(uint32_t, getter_frame, I, WORKER)
GTAV_PS4_FIELD(uint32_t, getter_timer, I, WORKER)
GTAV_PS4_FIELD(uint32_t, direct_frame, I, WORKER)
GTAV_PS4_FIELD(uint32_t, direct_timer, I, WORKER)
GTAV_PS4_FIELD(uint32_t, visible, I, WORKER)
GTAV_PS4_FIELD(uint32_t, selection, I, WORKER)
GTAV_PS4_FIELD(uint64_t, draw_rects, Q, WORKER)
GTAV_PS4_FIELD(uint64_t, draw_texts, Q, WORKER)
GTAV_PS4_FIELD(uint64_t, draw_sprites, Q, WORKER)
GTAV_PS4_FIELD(uint64_t, draw_lists, Q, WORKER)
GTAV_PS4_FIELD(uint64_t, feature_calls, Q, WORKER)
GTAV_PS4_FIELD(uint64_t, feature_ok, Q, WORKER)
GTAV_PS4_FIELD(uint32_t, last_feature_action, I, WORKER)
GTAV_PS4_FIELD(uint32_t, last_feature_param, I, WORKER)
GTAV_PS4_FIELD(uint64_t, jobs_run, Q, WORKER)
GTAV_PS4_FIELD(uint64_t, mailbox_commands, Q, WORKER)
GTAV_PS4_FIELD(uint64_t, pad_commands, Q, WORKER)
GTAV_PS4_FIELD(uint64_t, last_native_address, Q, WORKER)
GTAV_PS4_FIELD(uint32_t, diag_frames, I, WORKER)
GTAV_PS4_FIELD(uint32_t, shutdown_frames, I, WORKER)
GTAV_PS4_FIELD(uint32_t, job_refusals, I, WORKER)
GTAV_PS4_FIELD(uint32_t, tick_hz, I, WORKER)
GTAV_PS4_FIELD(uint32_t, storage_probe, I, WORKER)
GTAV_PS4_FIELD(int32_t, probe_app0_error, i, WORKER)
GTAV_PS4_FIELD(uint32_t, probe_app0_mode, I, WORKER)
GTAV_PS4_FIELD(int32_t, probe_data_error, i, WORKER)
GTAV_PS4_FIELD(uint32_t, probe_data_mode, I, WORKER)
GTAV_PS4_FIELD(int32_t, probe_menu_error, i, WORKER)
GTAV_PS4_FIELD(uint32_t, probe_menu_mode, I, WORKER)
GTAV_PS4_FIELD(uint32_t, storage_state, I, WORKER)
GTAV_PS4_FIELD(uint32_t, current_menu, I, WORKER)
GTAV_PS4_FIELD(uint32_t, selected_action, I, WORKER)
GTAV_PS4_FIELD(uint64_t, pad_got_expected, Q, HOST)
GTAV_PS4_FIELD(uint64_t, pad_hook_address, Q, WORKER)
GTAV_PS4_FIELD(uint64_t, pad_hook_calls, Q, WORKER)
GTAV_PS4_FIELD(uint32_t, pad_hook_state, I, WORKER)
GTAV_PS4_FIELD(uint32_t, pad_hook_inflight, I, WORKER)
GTAV_PS4_FIELD(uint32_t, touch_commands, I, WORKER)
GTAV_PS4_ARRAY(uint8_t, reserved, 212, B, WORKER)
