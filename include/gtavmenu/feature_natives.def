/* feature_natives.def -- single source of truth for the gameplay native table.
 *
 * X-macro list (see feature_actions.def / feature_toggles.def for the pattern). Each row
 * names one resolved gameplay native; listing it once here drives the two consumers that
 * used to be hand-maintained in lockstep in features.cpp:
 *
 *   - struct FeatureNatives          -- the uint64_t field that holds the address
 *   - load_feature_natives()         -- the assignment from the generated address macro
 *
 *   GTAV_FEATURE_NATIVE(field, SUFFIX)
 *     field   the FeatureNatives member name (g_n.<field>)
 *     SUFFIX  the address macro suffix: the row binds field = GTAV_NATIVE_ADDR_<SUFFIX>
 *             (almost always upper(field); a couple differ where the public native name
 *             does, e.g. set_run_sprint_multiplier -> ..._FOR_PLAYER).
 *
 * Build-gated natives (vehicle-preview streaming, prologue-skip) are NOT listed here: they
 * are declared unconditionally in the struct and assigned under their own #if blocks in
 * load_feature_natives(), so adding one stays a deliberate, gated edit.
 */
GTAV_FEATURE_NATIVE(player_id, PLAYER_ID)
GTAV_FEATURE_NATIVE(player_ped_id, PLAYER_PED_ID)
GTAV_FEATURE_NATIVE(set_player_invincible, SET_PLAYER_INVINCIBLE)
GTAV_FEATURE_NATIVE(set_entity_invincible, SET_ENTITY_INVINCIBLE)
GTAV_FEATURE_NATIVE(set_entity_health, SET_ENTITY_HEALTH)
GTAV_FEATURE_NATIVE(set_ped_armour, SET_PED_ARMOUR)
GTAV_FEATURE_NATIVE(get_ped_max_health, GET_PED_MAX_HEALTH)
GTAV_FEATURE_NATIVE(set_ped_max_health, SET_PED_MAX_HEALTH)
GTAV_FEATURE_NATIVE(clear_ped_blood_damage, CLEAR_PED_BLOOD_DAMAGE)
GTAV_FEATURE_NATIVE(clear_ped_wetness, CLEAR_PED_WETNESS)
GTAV_FEATURE_NATIVE(set_player_wanted_level, SET_PLAYER_WANTED_LEVEL)
GTAV_FEATURE_NATIVE(set_player_wanted_level_now, SET_PLAYER_WANTED_LEVEL_NOW)
// Ignored By Everyone: player-state setters re-asserted on the game-thread tick.
GTAV_FEATURE_NATIVE(set_police_ignore_player, SET_POLICE_IGNORE_PLAYER)
GTAV_FEATURE_NATIVE(set_everyone_ignore_player, SET_EVERYONE_IGNORE_PLAYER)
GTAV_FEATURE_NATIVE(set_player_can_be_hassled_by_gangs, SET_PLAYER_CAN_BE_HASSLED_BY_GANGS)
// Give Max Ammo: ped weapon-inventory natives (game-thread, like GIVE_WEAPON_TO_PED).
GTAV_FEATURE_NATIVE(set_ped_ammo, SET_PED_AMMO)
GTAV_FEATURE_NATIVE(get_max_ammo, GET_MAX_AMMO)
GTAV_FEATURE_NATIVE(set_run_sprint_multiplier, SET_RUN_SPRINT_MULTIPLIER_FOR_PLAYER)
GTAV_FEATURE_NATIVE(set_swim_multiplier, SET_SWIM_MULTIPLIER_FOR_PLAYER)
GTAV_FEATURE_NATIVE(set_ped_move_rate_override, SET_PED_MOVE_RATE_OVERRIDE)
GTAV_FEATURE_NATIVE(set_ped_can_ragdoll, SET_PED_CAN_RAGDOLL)
GTAV_FEATURE_NATIVE(set_ped_can_be_knocked_off_vehicle, SET_PED_CAN_BE_KNOCKED_OFF_VEHICLE)
GTAV_FEATURE_NATIVE(set_ped_config_flag, SET_PED_CONFIG_FLAG)
GTAV_FEATURE_NATIVE(set_ped_suffers_critical_hits, SET_PED_SUFFERS_CRITICAL_HITS)
