GTAV_FEATURE_NATIVE(disable_control_action, DISABLE_CONTROL_ACTION)
// noclip reads the SAME controls it disables this tick; a disabled control reports
// not-pressed via IS_CONTROL_PRESSED, so the held stick must be read with the disabled
// variant instead.
GTAV_FEATURE_NATIVE(is_disabled_control_pressed, IS_DISABLED_CONTROL_PRESSED)
GTAV_FEATURE_NATIVE(get_disabled_control_normal, GET_DISABLED_CONTROL_NORMAL)
// weapon
GTAV_FEATURE_NATIVE(give_weapon_to_ped, GIVE_WEAPON_TO_PED)
GTAV_FEATURE_NATIVE(set_current_ped_weapon, SET_CURRENT_PED_WEAPON)
// Weapon Tint: read the equipped weapon (Hash* out-param) + recolour it (worker-safe field set).
GTAV_FEATURE_NATIVE(get_current_ped_weapon, GET_CURRENT_PED_WEAPON)
GTAV_FEATURE_NATIVE(set_ped_weapon_tint_index, SET_PED_WEAPON_TINT_INDEX)
GTAV_FEATURE_NATIVE(set_ped_infinite_ammo_clip, SET_PED_INFINITE_AMMO_CLIP)
GTAV_FEATURE_NATIVE(remove_all_ped_weapons, REMOVE_ALL_PED_WEAPONS)
// weapon effects (game-thread only: called from the per-frame frame-hook tick)
GTAV_FEATURE_NATIVE(get_ped_last_weapon_impact_coord, GET_PED_LAST_WEAPON_IMPACT_COORD)
GTAV_FEATURE_NATIVE(add_owned_explosion, ADD_OWNED_EXPLOSION)
GTAV_FEATURE_NATIVE(start_script_fire, START_SCRIPT_FIRE)
// weapon damage multiplier (player-state setter, worker-safe; re-asserted each tick)
GTAV_FEATURE_NATIVE(set_player_weapon_damage_modifier, SET_PLAYER_WEAPON_DAMAGE_MODIFIER)
// noclip / free-move: camera getters + modify-existing entity setters. These run from
// the game-thread frame-hook tick (gtav_features_game_thread_tick), NOT the worker: the
// camera/move natives read engine state that is only valid in script context.
GTAV_FEATURE_NATIVE(get_gameplay_cam_relative_heading, GET_GAMEPLAY_CAM_RELATIVE_HEADING)
GTAV_FEATURE_NATIVE(get_gameplay_cam_rot, GET_GAMEPLAY_CAM_ROT)
// Interactive object placement (aim-follow): camera origin so the prop can be projected
// along the camera forward. Game-thread getter (driver tick), guarded -> aim mode degrades off.
GTAV_FEATURE_NATIVE(get_gameplay_cam_coord, GET_GAMEPLAY_CAM_COORD)
// Interactive object placement (surface raycast snap): synchronous LOS probe + result drain.
// Either may be unresolved (the driver guards on the fields and disables surface snap).
GTAV_FEATURE_NATIVE(start_shape_test_probe, START_EXPENSIVE_SYNCHRONOUS_SHAPE_TEST_LOS_PROBE)
GTAV_FEATURE_NATIVE(get_shape_test_result, GET_SHAPE_TEST_RESULT)
GTAV_FEATURE_NATIVE(set_entity_collision, SET_ENTITY_COLLISION)
GTAV_FEATURE_NATIVE(set_entity_has_gravity, SET_ENTITY_HAS_GRAVITY)
GTAV_FEATURE_NATIVE(set_entity_coords_no_offset, SET_ENTITY_COORDS_NO_OFFSET)
GTAV_FEATURE_NATIVE(set_entity_velocity, SET_ENTITY_VELOCITY)
// collapse the many frame-hook fires per frame to one step
GTAV_FEATURE_NATIVE(get_frame_count, GET_FRAME_COUNT)
// noclip: scale the per-frame step by real frame delta (ms)
GTAV_FEATURE_NATIVE(get_game_timer, GET_GAME_TIMER)
// force-ragdoll + task recovery (mutate the ped task tree -> game-thread/tick only)
GTAV_FEATURE_NATIVE(set_ped_to_ragdoll, SET_PED_TO_RAGDOLL)
GTAV_FEATURE_NATIVE(clear_ped_tasks_immediately, CLEAR_PED_TASKS_IMMEDIATELY)
// Self > Scenarios: enter a named scenario on the player (smoking, leaning, ...). Mutates the
// ped task tree -> game-thread only. Cancel reuses clear_ped_tasks (autopilot field below).
GTAV_FEATURE_NATIVE(task_start_scenario_in_place, TASK_START_SCENARIO_IN_PLACE)
// single-player money: STAT_GET_INT/STAT_SET_INT on SP{0,1,2}_TOTAL_CASH (worker-safe)
GTAV_FEATURE_NATIVE(stat_get_int, STAT_GET_INT)
GTAV_FEATURE_NATIVE(stat_set_int, STAT_SET_INT)
// ped/object spawner (game-thread; allocate entities like CREATE_VEHICLE)
GTAV_FEATURE_NATIVE(create_ped, CREATE_PED)
// Task a spawned ped to wander so it walks around instead of standing idle (game-thread; task tree).
GTAV_FEATURE_NATIVE(task_wander_standard, TASK_WANDER_STANDARD)
GTAV_FEATURE_NATIVE(create_object, CREATE_OBJECT)
GTAV_FEATURE_NATIVE(place_object_on_ground_properly, PLACE_OBJECT_ON_GROUND_PROPERLY)
// screen effects (game-thread tick; render-script state)
GTAV_FEATURE_NATIVE(set_nightvision, SET_NIGHTVISION)
GTAV_FEATURE_NATIVE(set_seethrough, SET_SEETHROUGH)
GTAV_FEATURE_NATIVE(set_timecycle_modifier, SET_TIMECYCLE_MODIFIER)
GTAV_FEATURE_NATIVE(set_timecycle_modifier_strength, SET_TIMECYCLE_MODIFIER_STRENGTH)
GTAV_FEATURE_NATIVE(clear_timecycle_modifier, CLEAR_TIMECYCLE_MODIFIER)
GTAV_FEATURE_NATIVE(animpostfx_play, ANIMPOSTFX_PLAY)
GTAV_FEATURE_NATIVE(animpostfx_stop_all, ANIMPOSTFX_STOP_ALL)
// ped control (game-thread; enumerate + retask nearby peds)
GTAV_FEATURE_NATIVE(task_combat_ped, TASK_COMBAT_PED)
GTAV_FEATURE_NATIVE(get_ped_nearby_peds, GET_PED_NEARBY_PEDS)
GTAV_FEATURE_NATIVE(set_ped_keep_task, SET_PED_KEEP_TASK)
GTAV_FEATURE_NATIVE(set_ped_flee_attributes, SET_PED_FLEE_ATTRIBUTES)
GTAV_FEATURE_NATIVE(task_smart_flee_ped, TASK_SMART_FLEE_PED)
GTAV_FEATURE_NATIVE(set_blocking_of_non_temporary_events, SET_BLOCKING_OF_NON_TEMPORARY_EVENTS)
GTAV_FEATURE_NATIVE(is_ped_a_player, IS_PED_A_PLAYER)
// Companions AGGRESSIVE/RAMPAGE proactive engage: shoot occupied cars and classify a tracked
// target handle as ped vs vehicle. Game-thread (pool walk + ped task tree).
GTAV_FEATURE_NATIVE(task_shoot_at_entity, TASK_SHOOT_AT_ENTITY)
GTAV_FEATURE_NATIVE(is_entity_a_vehicle, IS_ENTITY_A_VEHICLE)
// autopilot (game-thread tick; issue/adjust a vehicle drive task on the player ped ->
// mutates the ped task tree, so never worker-direct). CLEAR_PED_TASKS is the gentle
// stop (car coasts) vs the _IMMEDIATELY variant above; GET_PED_IN_VEHICLE_SEAT confirms
// the player is the driver before handing the wheel to the AI.
GTAV_FEATURE_NATIVE(task_vehicle_drive_to_coord_longrange, TASK_VEHICLE_DRIVE_TO_COORD_LONGRANGE)
GTAV_FEATURE_NATIVE(task_vehicle_drive_wander, TASK_VEHICLE_DRIVE_WANDER)
GTAV_FEATURE_NATIVE(set_drive_task_driving_style, SET_DRIVE_TASK_DRIVING_STYLE)
GTAV_FEATURE_NATIVE(set_drive_task_cruise_speed, SET_DRIVE_TASK_CRUISE_SPEED)
GTAV_FEATURE_NATIVE(clear_ped_tasks, CLEAR_PED_TASKS)
GTAV_FEATURE_NATIVE(get_ped_in_vehicle_seat, GET_PED_IN_VEHICLE_SEAT)
// Phase-B minigame natives (City Blackout, Zombie Outbreak, experimental Flood). Resolved
// offline and pinned via `make feature-native-header`; assigned in load_feature_natives().
// Blackout: SET_ARTIFICIAL_LIGHTS_STATE(BOOL)
GTAV_FEATURE_NATIVE(set_artificial_lights_state, SET_ARTIFICIAL_LIGHTS_STATE)
// Zombies: harden spawned ped combat AI
GTAV_FEATURE_NATIVE(set_ped_combat_attributes, SET_PED_COMBAT_ATTRIBUTES)
// Zombies: put spawns in a player-hostile group
GTAV_FEATURE_NATIVE(set_ped_relationship_group_hash, SET_PED_RELATIONSHIP_GROUP_HASH)
// Zombies: register the hostile group (out-param)
GTAV_FEATURE_NATIVE(add_relationship_group, ADD_RELATIONSHIP_GROUP)
// Zombies: make the group hate the player group
GTAV_FEATURE_NATIVE(set_relationship_between_groups, SET_RELATIONSHIP_BETWEEN_GROUPS)
// Companions / bodyguards: group membership + combat behaviour for friendly spawned peds.
GTAV_FEATURE_NATIVE(get_player_group, GET_PLAYER_GROUP)
GTAV_FEATURE_NATIVE(set_ped_as_group_member, SET_PED_AS_GROUP_MEMBER)
GTAV_FEATURE_NATIVE(set_ped_never_leaves_group, SET_PED_NEVER_LEAVES_GROUP)
GTAV_FEATURE_NATIVE(set_group_formation, SET_GROUP_FORMATION)
GTAV_FEATURE_NATIVE(set_group_separation_range, SET_GROUP_SEPARATION_RANGE)
GTAV_FEATURE_NATIVE(set_ped_combat_ability, SET_PED_COMBAT_ABILITY)
GTAV_FEATURE_NATIVE(set_ped_combat_movement, SET_PED_COMBAT_MOVEMENT)
// Companions: SET_PED_ACCURACY(ped, 0..100) hit chance
GTAV_FEATURE_NATIVE(set_ped_accuracy, SET_PED_ACCURACY)
// Companions: tag tracked guards on the minimap. HUD natives, applied on the game-thread
// bodyguard tick; REMOVE_BLIP takes a Blip* out-param (like DELETE_PED).
GTAV_FEATURE_NATIVE(add_blip_for_entity, ADD_BLIP_FOR_ENTITY)
GTAV_FEATURE_NATIVE(set_blip_sprite, SET_BLIP_SPRITE)
GTAV_FEATURE_NATIVE(set_blip_colour, SET_BLIP_COLOUR)
GTAV_FEATURE_NATIVE(set_blip_as_friendly, SET_BLIP_AS_FRIENDLY)
GTAV_FEATURE_NATIVE(remove_blip, REMOVE_BLIP)
// Flood (experimental): MODIFY_WATER(x,y,radius,h)
GTAV_FEATURE_NATIVE(modify_water, MODIFY_WATER)
// Zombie Outbreak survival loop: poll the tracked horde (kill vs despawn) and despawn it on
// stop. Read/called only from the game-thread driver tick. Each is independently gated, so an
// unresolved one degrades that sub-feature instead of locking the mode.
// Zombies: a tracked handle died -> count a kill
GTAV_FEATURE_NATIVE(is_entity_dead, IS_ENTITY_DEAD)
// Zombies: distinguish an engine despawn from a kill
GTAV_FEATURE_NATIVE(does_entity_exist, DOES_ENTITY_EXIST)
// Zombies: despawn the horde on mode stop (DELETE_PED(Ped*))
GTAV_FEATURE_NATIVE(delete_ped, DELETE_PED)
// World > Spectacle (spectacle.inc). Wind setters are worker-safe global field writes (like
// weather). SHAKE_GAMEPLAY_CAM is a render-script camera effect and the PTFX request/use/start are
// streaming + fx-spawn natives -> driven on the game thread (frame-hook tick / drain).
GTAV_FEATURE_NATIVE(set_wind_speed, SET_WIND_SPEED)
GTAV_FEATURE_NATIVE(set_wind_direction, SET_WIND_DIRECTION)
GTAV_FEATURE_NATIVE(shake_gameplay_cam, SHAKE_GAMEPLAY_CAM)
GTAV_FEATURE_NATIVE(request_named_ptfx_asset, REQUEST_NAMED_PTFX_ASSET)
GTAV_FEATURE_NATIVE(has_named_ptfx_asset_loaded, HAS_NAMED_PTFX_ASSET_LOADED)
GTAV_FEATURE_NATIVE(use_particle_fx_asset, USE_PARTICLE_FX_ASSET)
// Tint the next non-looped PTFX (call before START) so firework sparks aren't default-black.
GTAV_FEATURE_NATIVE(set_particle_fx_non_looped_colour, SET_PARTICLE_FX_NON_LOOPED_COLOUR)
GTAV_FEATURE_NATIVE(start_particle_fx_non_looped_at_coord, START_PARTICLE_FX_NON_LOOPED_AT_COORD)
// Self > Free Camera (free_cam.inc). A detached scripted camera driven on the game-thread
// frame-hook tick: the cam create/activate/render natives touch render-script state (like the
// spectacle shake), so they are game-thread only. SET_FOCUS_POS_AND_VEL streams the world around
// the cam; CLEAR_FOCUS releases it on exit. Either focus native may be unresolved -> the driver
// guards on the field.
GTAV_FEATURE_NATIVE(create_cam_with_params, CREATE_CAM_WITH_PARAMS)
GTAV_FEATURE_NATIVE(set_cam_active, SET_CAM_ACTIVE)
GTAV_FEATURE_NATIVE(render_script_cams, RENDER_SCRIPT_CAMS)
GTAV_FEATURE_NATIVE(destroy_cam, DESTROY_CAM)
GTAV_FEATURE_NATIVE(set_cam_coord, SET_CAM_COORD)
GTAV_FEATURE_NATIVE(set_cam_rot, SET_CAM_ROT)
GTAV_FEATURE_NATIVE(set_focus_pos_and_vel, SET_FOCUS_POS_AND_VEL)
GTAV_FEATURE_NATIVE(clear_focus, CLEAR_FOCUS)
// Fun-factor sandbox extras. APPLY_FORCE_TO_ENTITY = vehicle rocket-boost impulse (game-thread).
// GET_LAST_DRIVEN_VEHICLE backs Teleport Into Last Vehicle (game-thread SET_PED_INTO_VEHICLE).
// CLONE_PED is the gun-toolkit clone gun (game-thread, allocates a ped). SET_/RESET_ENTITY_ALPHA +
// ATTACH_/DETACH_ENTITY_TO_ENTITY drive the Spooner entity tweaks (modify-existing field stores).
GTAV_FEATURE_NATIVE(apply_force_to_entity, APPLY_FORCE_TO_ENTITY)
GTAV_FEATURE_NATIVE(get_last_driven_vehicle, GET_LAST_DRIVEN_VEHICLE)
GTAV_FEATURE_NATIVE(clone_ped, CLONE_PED)
GTAV_FEATURE_NATIVE(set_entity_alpha, SET_ENTITY_ALPHA)
GTAV_FEATURE_NATIVE(reset_entity_alpha, RESET_ENTITY_ALPHA)
GTAV_FEATURE_NATIVE(attach_entity_to_entity, ATTACH_ENTITY_TO_ENTITY)
GTAV_FEATURE_NATIVE(detach_entity, DETACH_ENTITY)
// Weapons > Attachments (weapon_attachments.inc). Give/remove a component on the player's current
// weapon -- ped weapon-manager natives, game-thread like GIVE_WEAPON_TO_PED. HAS_..._COMPONENT
// reads the installed state for the per-slot cycler.
GTAV_FEATURE_NATIVE(give_weapon_component_to_ped, GIVE_WEAPON_COMPONENT_TO_PED)
GTAV_FEATURE_NATIVE(remove_weapon_component_from_ped, REMOVE_WEAPON_COMPONENT_FROM_PED)
GTAV_FEATURE_NATIVE(has_ped_got_weapon_component, HAS_PED_GOT_WEAPON_COMPONENT)
