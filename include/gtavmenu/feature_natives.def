GTAV_FEATURE_NATIVE(request_collision_at_coord, REQUEST_COLLISION_AT_COORD)
GTAV_FEATURE_NATIVE(has_collision_loaded_around_entity, HAS_COLLISION_LOADED_AROUND_ENTITY)
