GTAV_FEATURE_NATIVE(set_ped_population_budget, SET_PED_POPULATION_BUDGET)
GTAV_FEATURE_NATIVE(set_vehicle_population_budget, SET_VEHICLE_POPULATION_BUDGET)
// self / teleport (modify-existing entity, worker-safe)
GTAV_FEATURE_NATIVE(set_entity_coords, SET_ENTITY_COORDS)
GTAV_FEATURE_NATIVE(set_entity_heading, SET_ENTITY_HEADING)
// Interactive object move mode: full 3-axis reorientation. Either may be unresolved (the
// driver guards on the field and falls back to heading-only).
GTAV_FEATURE_NATIVE(get_entity_rotation, GET_ENTITY_ROTATION)
GTAV_FEATURE_NATIVE(set_entity_rotation, SET_ENTITY_ROTATION)
GTAV_FEATURE_NATIVE(set_entity_visible, SET_ENTITY_VISIBLE)
GTAV_FEATURE_NATIVE(get_first_blip_info_id, GET_FIRST_BLIP_INFO_ID)
GTAV_FEATURE_NATIVE(get_blip_info_id_type, GET_BLIP_INFO_ID_TYPE)
GTAV_FEATURE_NATIVE(get_blip_coords, GET_BLIP_COORDS)
// streaming-aware teleport (freeze + stream-in, so a far jump can't fault on void)
