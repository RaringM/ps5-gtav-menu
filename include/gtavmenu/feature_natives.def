GTAV_FEATURE_NATIVE(set_gravity_level, SET_GRAVITY_LEVEL)
GTAV_FEATURE_NATIVE(set_time_scale, SET_TIME_SCALE)
// Thin Population: global int budget setters (0 = sparsest), no entity walk. Re-asserted on
