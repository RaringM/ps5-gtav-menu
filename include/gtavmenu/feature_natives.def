GTAV_FEATURE_NATIVE(has_anim_dict_loaded, HAS_ANIM_DICT_LOADED)
GTAV_FEATURE_NATIVE(task_play_anim, TASK_PLAY_ANIM)
// Wardrobe / outfit editor: modify-existing-ped component + prop variation (worker-safe class).
GTAV_FEATURE_NATIVE(set_ped_component_variation, SET_PED_COMPONENT_VARIATION)
GTAV_FEATURE_NATIVE(get_number_of_ped_drawable_variations, GET_NUMBER_OF_PED_DRAWABLE_VARIATIONS)
GTAV_FEATURE_NATIVE(get_number_of_ped_texture_variations, GET_NUMBER_OF_PED_TEXTURE_VARIATIONS)
